# Node.js dependencies
node_modules/
**/node_modules/

# Build and test outputs
frontend/build/
coverage/
**/coverage/
frontend/frontend-audit.json

# IDE files
.vs/
.DS_Store

# Environment files may contain secrets. Keep only the example template.
.env
.env.*
!.env.example

# Certificates and private keys must not be committed.
*.pem
*.key
*.crt
*.p12
*.pfx
*.cer
certs/
backend/certs/

# Runtime logs are local operational data; retain only the directory marker.
logs/*
!logs/
!logs/.gitkeep
