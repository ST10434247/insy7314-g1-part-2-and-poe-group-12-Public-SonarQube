# Example environment configuration for the HustleHub Part 1 backend.
# The actual .env file contains local secrets and is excluded from Git using .gitignore.

PORT=3000

# Secret used to sign and verify JWT authentication tokens.
# Replace this placeholder with a strong random secret in the local .env file.
JWT_SECRET=jwt_secret_here

# Local paths to the HTTPS certificate and private key.
# These files are excluded from source control and must not be committed to GitHub.
SSL_KEY_PATH=../certs/key.pem
SSL_CERT_PATH=../certs/cert.pem