# Application server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# MongoDB connection string. Docker Compose does not start MongoDB for you.
# Use MongoDB Atlas, or a reachable MongoDB instance.
MONGODB_URI=replace_with_your_mongodb_connection_string

# JWT signing secret: generate a unique value; never reuse a production secret.
JWT_SECRET=replace_with_a_long_random_secret

# Local development certificate paths (resolved from backend/server.js).
# Docker Compose overrides these with /app/certs/key.pem and /app/certs/cert.pem.
SSL_KEY_PATH=../backend/certs/key.pem
SSL_CERT_PATH=../backend/certs/cert.pem

# Initial administrator account (used by backend/scripts/createAdmin.js).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# Grafana administrator (required by the Docker Compose Grafana service).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_unique_strong_grafana_password
