          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{clientToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"gigId\": \"{{gigId}}\",\n  \"requirements\": \"Please create a modern responsive website for my small business.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/bookings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookings"
          ]
