    {
      "name": "15 - Reject Gig Creation Without Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Unauthorised Test Gig\",\n  \"description\": \"This request should be rejected because no JWT token is supplied.\",\n  \"category\": \"Testing\",\n  \"price\": 100,\n  \"deliveryDays\": 5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/gigs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
