      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Booking creation returns 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Created booking has an ID', function () {",
              "    pm.expect(json.booking._id).to.be.a('string').and.not.empty;",
              "});",
              "pm.test('Booking starts as pending', function () {",
              "    pm.expect(json.booking.status).to.eql('pending');",
              "});",
              "if (json.booking && json.booking._id) pm.collectionVariables.set('bookingId', json.booking._id);"
            ]
          }
        }
      ]
