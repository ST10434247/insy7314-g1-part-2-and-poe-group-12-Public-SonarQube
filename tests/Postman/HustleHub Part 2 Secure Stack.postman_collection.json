  "item": [
    {
      "name": "1 - Register Freelancer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{freelancerEmail}}\",\n  \"password\": \"{{freelancerPassword}}\",\n  \"role\": \"freelancer\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = Date.now().toString();",
              "pm.collectionVariables.set('freelancerEmail', 'newman.freelancer.' + runId + '@example.com');",
              "pm.collectionVariables.set('clientEmail', 'newman.client.' + runId + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Freelancer registration returns 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Registered user has freelancer role', function () {",
              "    pm.expect(pm.response.json().user.role).to.eql('freelancer');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2 - Login Freelancer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{freelancerEmail}}\",\n  \"password\": \"{{freelancerPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Freelancer login returns 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Login returns JWT token', function () {",
              "    pm.expect(json.token).to.be.a('string').and.not.empty;",
              "});",
              "pm.collectionVariables.set('freelancerToken', json.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "3 - Create Gig",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{freelancerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Newman Test Web Design Service\",\n  \"description\": \"Professional website design and development service for small businesses.\",\n  \"category\": \"Web Development\",\n  \"price\": 350,\n  \"deliveryDays\": 14\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/gigs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "gigs"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Gig creation returns 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "const gig = json.gig || json;",
              "pm.test('Created gig has an ID', function () {",
              "    pm.expect(gig._id).to.be.a('string').and.not.empty;",
              "});",
              "if (gig && gig._id) pm.collectionVariables.set('gigId', gig._id);"
            ]
          }
        }
      ]
    },
