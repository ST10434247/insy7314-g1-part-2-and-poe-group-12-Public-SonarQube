    "name": "HustleHub Part 2 Secure Stack",
    "description": "Part 2 Secure Stack tests for authentication, gig management, booking workflow, transactions, payment simulation, income tracking, validation and RBAC.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:3000"
    },
    {
      "key": "freelancerEmail",
      "value": "newman.freelancer@example.com"
    },
    {
      "key": "freelancerPassword",
      "value": "NewmanPass123!"
    },
    {
      "key": "clientEmail",
      "value": "newman.client@example.com"
    },
    {
      "key": "clientPassword",
      "value": "NewmanPass123!"
    },
    {
      "key": "freelancerToken",
      "value": ""
    },
