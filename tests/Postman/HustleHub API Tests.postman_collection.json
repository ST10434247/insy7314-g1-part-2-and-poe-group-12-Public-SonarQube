        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Wildlife Photography\",\n  \"description\": \"Professional wildlife photography services for conservation projects and nature publications.\",\n  \"category\": \"Photography\",\n  \"price\": 1500,\n  \"deliveryDays\": 7\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Gig creation returns 201', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "const gig = json.gig || json;",
              "pm.test('Created gig has an ID', function () { pm.expect(gig._id).to.be.a('string').and.not.empty; });",
              "pm.collectionVariables.set('gigId', gig._id);"
            ]
          }
        }
      ]
